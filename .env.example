# ---------------------------------------------------------------------------
# Copy to .env and fill in. The bot reads this file at start-up.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# From the Discord developer portal: https://discord.com/developers/applications
# -> your application -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-bot-token

# Your numeric Discord user id (enable Developer Mode, right-click yourself ->
# Copy User ID). Only these users can talk to the bot.
# The agent can run tools on this machine, so keep this list short.
DISCORD_USER_IDS=773201798143934534

# Set to 1 to let anybody DM the bot. Only do this on a trusted machine.
ALLOW_ANY_USER=0

# When a stranger DMs the bot, reply once with their own user id so they can add
# themselves to the list above. Set to 0 for complete silence.
ALLOWLIST_HINT=1

# --- OpenCode service -------------------------------------------------------
# Leave these unset and the bot discovers the local service automatically:
# it runs `opencode service status` and reads the password from
# ~/.config/opencode/service.json.
# OPENCODE_URL=http://127.0.0.1:4096
# OPENCODE_USERNAME=opencode
# OPENCODE_PASSWORD=

# Working directory for new conversations (defaults to your home directory).
# OPENCODE_DIRECTORY=/home/you/code

# --- Defaults ---------------------------------------------------------------
# Model used for new conversations. Format: provider/model. Empty = server default.
# DEFAULT_MODEL=google/gemini-3.8-flash
# Reasoning effort applied when picking a model that supports it.
# DEFAULT_EFFORT=high
# DEFAULT_AGENT=build

# --- Behaviour --------------------------------------------------------------
# Seconds between edits of the streaming message (Discord rate limits apply).
# EDIT_INTERVAL=1.5
# Messages sent while a turn is running are injected into the live turn instead
# of being queued. Set to 0 to queue them.
# STEER_WHEN_BUSY=1
# Hard limit on a single turn, in seconds.
# TURN_TIMEOUT=3600
# Give up if the model sends no activity at all for this long (seconds). Catches
# a dropped event stream without waiting for the full turn timeout.
# STALL_TIMEOUT=300
# Show tool calls (✅ read, ❌ bash …) under each answer.
# SHOW_TOOLS=1
# Show the model's reasoning as a dimmed block. Noisy, off by default.
# SHOW_REASONING=0
# How many sessions /sessions can page through.
# SESSION_LIST_LIMIT=100
# Where uploaded files are stored before being handed to the model.
# ATTACHMENT_DIR=~/.cache/opencode-discord/attachments
